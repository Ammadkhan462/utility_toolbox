<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: exclude all app data from cloud backup and device transfer.
     Scan history, clipboard items and saved locations are personal and are
     never uploaded (matches PRIVACY_POLICY.md). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
